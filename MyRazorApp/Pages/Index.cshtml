@page
@model IndexModel
@{
    ViewData["Title"] = "Class Management";
}

<style>
    body {
        background: linear-gradient(120deg, #f6f9fc, #dceefb);
    }

    .card {
        border-radius: 20px;
    }

    .table thead {
        background-color: #2575fc;
        color: white;
    }

    .table tbody tr:hover {
        background-color: #f1f1f1;
    }

    th.clickable {
        cursor: pointer;
        transition: background-color 0.2s;
    }

    th.clickable.selected {
        background-color: #00cec9;
        color: black;
    }

    td.selected-column {
        background-color: #dff9fb !important;
        color: #2d3436;
    }

    .logout-btn {
        background-color: rgba(220, 53, 69, 0.85);
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 25px;
        font-weight: 600;
        font-size: 16px;
        transition: background-color 0.3s ease;
    }

    .logout-btn:hover {
        background-color: rgba(220, 53, 69, 1);
    }
</style>

<div class="container mt-5">
    <h2 class="text-center mb-4 text-primary">🎓 Class Management System 🎓</h2>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center">
                    <h5 class="mb-0">@((Model.NewClass.Id == 0) ? "Add New Class" : "Update Class")</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="form-group mb-3">
                            <label>📌 Class Name</label>
                            <input type="text" class="form-control" asp-for="NewClass.ClassName" />
                            <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label>👥 Student Count</label>
                            <input type="number" class="form-control" asp-for="NewClass.StudentCount" />
                            <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label>📝 Description</label>
                            <textarea class="form-control" asp-for="NewClass.Description" rows="3"></textarea>
                            <span asp-validation-for="NewClass.Description" class="text-danger"></span>
                        </div>

                        <input type="hidden" asp-for="NewClass.Id" />

                        <button type="submit" asp-page-handler="@((Model.NewClass.Id == 0) ? "Add" : "Update")" class="btn btn-success w-100 mt-3">
                            @((Model.NewClass.Id == 0) ? "➕ Add Class" : "🔄 Update Class")
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center">
                    <h5 class="mb-0">📄 Class List</h5>
                </div>
                <div class="card-body">
                    <form method="get" class="mb-3">
                        <div class="row g-2">
                            <div class="col-md-10">
                                <input type="text" class="form-control" name="SearchTerm" value="@Model.SearchTerm" placeholder="🔍 Search..." />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">Search</button>
                            </div>
                        </div>
                    </form>

                    <div class="row g-2 mb-4">
                        <div class="col-md-10"></div>
                        <div class="col-md-2">
                            <form method="post" asp-page-handler="Logout">
                                <button type="submit" class="btn logout-btn w-100">🔓 Logout</button>
                            </form>
                        </div>
                    </div>

                    <form method="post" asp-page-handler="ExportJson">
                        <input type="hidden" name="isFiltered" value="@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "false" : "true")" />
                        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                        <input type="hidden" id="SelectedColumnsInputAll" name="selectedColumns" />
                        <button type="submit" class="btn btn-secondary mb-3">⬇ Export JSON</button>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-hover table-bordered">
                            <thead>
                                <tr>
                                    <th class="clickable" data-index="0">Class Name</th>
                                    <th class="clickable" data-index="1">Student Count</th>
                                    <th class="clickable" data-index="2">Description</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.FilteredClasses.Any())
                                {
                                    @foreach (var item in Model.FilteredClasses)
                                    {
                                        <tr>
                                            <td>@item.ClassName</td>
                                            <td>@item.StudentCount</td>
                                            <td>@item.Description</td>
                                            <td>
                                                <form method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" asp-page-handler="Edit" class="btn btn-warning btn-sm">✏️</button>
                                                    <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?');">🗑️</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center">No classes found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <nav>
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="./Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-SearchTerm="@Model.SearchTerm">Previous</a>
                    </li>
                    <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-page="./Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-SearchTerm="@Model.SearchTerm">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<script>
    const selectedColumns = new Set();

    function updateColumnHighlighting() {
        document.querySelectorAll("td").forEach(td => td.classList.remove("selected-column"));

        selectedColumns.forEach(index => {
            document.querySelectorAll("tbody tr").forEach(row => {
                const cell = row.querySelectorAll("td")[index];
                if (cell) {
                    cell.classList.add("selected-column");
                }
            });
        });

        document.getElementById("SelectedColumnsInputAll").value = Array.from(selectedColumns).join(",");
    }

    document.querySelectorAll('th.clickable').forEach(th => {
        th.addEventListener('click', () => {
            const index = parseInt(th.getAttribute('data-index'));
            if (selectedColumns.has(index)) {
                selectedColumns.delete(index);
                th.classList.remove('selected');
            } else {
                selectedColumns.add(index);
                th.classList.add('selected');
            }
            updateColumnHighlighting();
        });
    });
</script>
