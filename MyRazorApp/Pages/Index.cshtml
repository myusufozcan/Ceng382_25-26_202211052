@page
@model IndexModel
@{
    ViewData["Title"] = "Class Management";
}

<style>
    body {
        background: linear-gradient(120deg, #f6f9fc, #dceefb);
    }

    .card {
        border-radius: 20px;
    }

    .table thead {
        background-color: #0d6efd;
        color: white;
    }

    .table tbody tr:hover {
        background-color: #f1f1f1;
    }
</style>

<div class="container mt-5">
    <h2 class="text-center mb-4 text-primary">🎓 Class Management System 🎓</h2>
    
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center">
                    <h5 class="mb-0">@((Model.NewClass.Id == 0) ? "Add New Class" : "Update Class")</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="form-group mb-3">
                            <label for="ClassName">📌 Class Name</label>
                            <input type="text" class="form-control" asp-for="NewClass.ClassName" id="ClassName" placeholder="Enter class name" />
                            <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label for="StudentCount">👥 Student Count</label>
                            <input type="number" class="form-control" asp-for="NewClass.StudentCount" id="StudentCount" placeholder="Enter student count" />
                            <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label for="Description">📝 Description</label>
                            <textarea class="form-control" asp-for="NewClass.Description" id="Description" rows="3" placeholder="Enter description"></textarea>
                            <span asp-validation-for="NewClass.Description" class="text-danger"></span>
                        </div>

                        <input type="hidden" asp-for="NewClass.Id" />

                        <button type="submit" asp-page-handler="@((Model.NewClass.Id == 0) ? "Add" : "Update")" class="btn btn-success w-100 mt-3">
                            @((Model.NewClass.Id == 0) ? "➕ Add Class" : "🔄 Update Class")
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center">
                    <h5 class="mb-0">📄 Class List</h5>
                </div>
                <div class="card-body">
                    <form method="get" class="mb-3">
                        <div class="row">
                            <div class="col-md-5">
                                <input type="text" class="form-control" name="filterClassName" value="@Model.FilterClassName" placeholder="Filter by class name" />
                            </div>
                            <div class="col-md-5">
                                <input type="number" class="form-control" name="filterStudentCount" value="@Model.FilterStudentCount" placeholder="Filter by student count" />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">Filter</button>
                            </div>
                        </div>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-hover table-bordered">
                            <thead>
                                <tr>
                                    <th>Class Name</th>
                                    <th>Student Count</th>
                                    <th>Description</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.FilteredClasses.Any())
                                {
                                    @foreach (var item in Model.FilteredClasses)
                                    {
                                        <tr>
                                            <td>@item.ClassName</td>
                                            <td>@item.StudentCount</td>
                                            <td>@item.Description</td>
                                            <td>
                                                <form method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" asp-page-handler="Edit" class="btn btn-warning btn-sm">✏️ Edit</button>
                                                    <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">🗑️ Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center">No classes found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <nav>
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                <a class="page-link" asp-page="./Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-filterClassName="@Model.FilterClassName" asp-route-filterStudentCount="@Model.FilterStudentCount">Previous</a>
                            </li>
                            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-page="./Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-filterClassName="@Model.FilterClassName" asp-route-filterStudentCount="@Model.FilterStudentCount">Next</a>
                            </li>
                        </ul>
                    </nav>

                </div>
            </div>
        </div>
    </div>
</div>
